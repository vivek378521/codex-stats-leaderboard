# Turso database (https://app.turso.tech -> create a database, then copy these)
# The free plan is more than enough: 100 databases, 5GB, 500M rows read/mo.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="eyJ..."

# Shared secret used to HMAC-sign submissions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value as CODEX_STATS_LEADERBOARD_KEY on the machines that submit.
LEADERBOARD_SUBMIT_KEY="replace-with-64-hex-characters"
